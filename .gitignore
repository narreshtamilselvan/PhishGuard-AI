# ============================================================================
# PhishGuard AI — .gitignore
# ============================================================================

# --------------- Python bytecode -------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --------------- Virtual environments --------------------------------------
venv/
env/
.venv/
.env

# --------------- Distribution / Build --------------------------------------
dist/
build/
*.egg-info/
*.egg
*.whl

# --------------- Generated data & models (re-create via setup_and_train.py)
models/*.pkl
data/*.csv
*.db

# --------------- IDE / Editor ----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --------------- OS-specific -----------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --------------- Logs & temp -----------------------------------------------
*.log
*.tmp
*.bak

# --------------- Jupyter ---------------------------------------------------
.ipynb_checkpoints/

# --------------- pytest / coverage -----------------------------------------
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --------------- mypy ------------------------------------------------------
.mypy_cache/
